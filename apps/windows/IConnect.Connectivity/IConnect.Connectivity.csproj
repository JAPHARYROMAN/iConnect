<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><PlatformTarget>x64</PlatformTarget></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../IConnect.Storage.Windows/IConnect.Storage.Windows.csproj" />
    <ProjectReference Include="../../../shared/IConnect.Core/IConnect.Core.csproj" />
    <PackageReference Include="MediaToolkit.WebRtc.Native.win-x64" Version="0.24.6.1"
                      GeneratePathProperty="true" ExcludeAssets="build" />
    <None Include="$(PkgMediaToolkit_WebRtc_Native_win-x64)/native/win-x64/datachannel.dll"
          Condition="'$(PkgMediaToolkit_WebRtc_Native_win-x64)' != ''" Link="libDatachannel/datachannel.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
