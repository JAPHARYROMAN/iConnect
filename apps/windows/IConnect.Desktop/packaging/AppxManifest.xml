<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 desktop rescap">
  <Identity Name="iConnect.Desktop" Publisher="CN=iConnect" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>iConnect</DisplayName>
    <PublisherDisplayName>iConnect</PublisherDisplayName>
    <Logo>PackageAssets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application Id="iConnect" Executable="IConnect.Desktop.exe"
                 uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="iConnect" Description="Direct file access and transfer between approved devices"
                          Square150x150Logo="PackageAssets\Square150x150Logo.png"
                          Square44x44Logo="PackageAssets\Square44x44Logo.png" BackgroundColor="#14213D" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="IConnect.Desktop.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="iConnectStartup" Enabled="false" DisplayName="iConnect" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
