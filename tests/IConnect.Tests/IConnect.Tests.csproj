<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IncludeAttachmentWorker>true</IncludeAttachmentWorker>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../IConnect.Attachment.Fixture/IConnect.Attachment.Fixture.csproj" ReferenceOutputAssembly="false" />
    <None Include="../../shared/test-vectors/stun-uris.tsv" Link="stun-uris.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../shared/test-vectors/upload-batches.json" Link="upload-batches.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="All" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <ProjectReference Include="../../apps/windows/IConnect.Connectivity/IConnect.Connectivity.csproj" />
    <ProjectReference Include="../../backend/IConnect.Rendezvous/IConnect.Rendezvous.csproj" />
    <ProjectReference Include="../../apps/windows/IConnect.Storage.Windows/IConnect.Storage.Windows.csproj" />
    <ProjectReference Include="../../apps/windows/IConnect.AppModel/IConnect.AppModel.csproj" />
  </ItemGroup>
  <Target Name="CopyAttachmentFixture" AfterTargets="Build">
    <ItemGroup><AttachmentFixtureFiles Include="../IConnect.Attachment.Fixture/bin/$(Configuration)/net10.0/win-x64/**/*" /></ItemGroup>
    <Copy SourceFiles="@(AttachmentFixtureFiles)" DestinationFiles="@(AttachmentFixtureFiles->'$(OutDir)AttachmentWorker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
