<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="All" />
    <ProjectReference Include="../../apps/windows/IConnect.Preview.Windows/IConnect.Preview.Windows.csproj" />
    <ProjectReference Include="../../apps/windows/IConnect.AppModel/IConnect.AppModel.csproj" />
    <ProjectReference Include="../../apps/windows/IConnect.Preview.Worker/IConnect.Preview.Worker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../IConnect.Preview.Fixture/IConnect.Preview.Fixture.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="../IConnect.InteropRunner/PreviewFixtures.cs" Link="PreviewFixtures.cs" />
    <Compile Include="../../apps/windows/IConnect.Desktop/TransferNetworkMonitor.cs" Link="TransferNetworkMonitor.cs" />
  </ItemGroup>
  <Target Name="CopyPreviewWorkers" AfterTargets="Build">
    <ItemGroup>
      <WorkerFiles Include="../../apps/windows/IConnect.Preview.Worker/bin/$(Configuration)/net10.0-windows10.0.26100.0/win-x64/**/*" />
      <FixtureFiles Include="../IConnect.Preview.Fixture/bin/$(Configuration)/net10.0-windows10.0.26100.0/win-x64/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFiles="@(WorkerFiles->'$(OutDir)PreviewWorker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FixtureFiles)" DestinationFiles="@(FixtureFiles->'$(OutDir)Fixture/PreviewWorker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
